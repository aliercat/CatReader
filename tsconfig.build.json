{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false,
    "rootDir": "src",
    "outDir": "out"
  },
  "include": ["src/main/**/*", "src/preload/**/*"],
  "exclude": ["src/**/__tests__/**"]
}
